# map-service
PORT=4013
DATABASE_URL="mysql://traveler:traveler123@localhost:3306/traveler_map"
REDIS_URL="redis://localhost:6379"

# Must match the auth-service signing secret.
JWT_ACCESS_SECRET="dev-access-secret-change-me"

# Provider selection. Falls back to the offline provider when unset or failing.
MAP_PROVIDER=mapbox   # or "google" (needs GOOGLE_MAPS_API_KEY)

# Server-side Mapbox token (never sent to clients).
MAPBOX_ACCESS_TOKEN=

# Google Maps Platform server key (enable Places, Directions, Geocoding APIs)
GOOGLE_MAPS_API_KEY=
# Public pk.* token handed to the mobile renderer via /v1/geocode/config.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE_URL="mapbox://styles/mapbox/streets-v12"
MAPBOX_TIMEOUT_MS=8000

MAP_RATE_LIMIT_PER_MINUTE=60
OFF_ROUTE_THRESHOLD_METERS=50
REROUTE_COOLDOWN_SECONDS=15
