# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TravelerGuideMobile' do
  # react-native-maps with the Google Maps provider (iOS). Must be declared
  # above use_native_modules! so the Google subspec (GoogleMaps SDK) is linked.
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-maps/Google', :path => rn_maps_path

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Pull the Google Maps key from the git-ignored ios/Maps.xcconfig into the
    # app target's generated Pods xcconfigs, so $(GOOGLE_MAPS_API_KEY) resolves
    # on every build (Xcode / `pnpm ios`) without committing the key.
    Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-TravelerGuideMobile', '*.xcconfig')).each do |xcconfig|
      include_line = '#include? "../../../Maps.xcconfig"'
      contents = File.read(xcconfig)
      File.open(xcconfig, 'a') { |f| f.puts("\n#{include_line}") } unless contents.include?(include_line)
    end
  end
end
