# Shared
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://traveler:traveler123@localhost:5672

# API Gateway
PORT=4000
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
TRIP_SERVICE_URL=http://localhost:4003
PLACE_SERVICE_URL=http://localhost:4004
NAVIGATION_SERVICE_URL=http://localhost:4005
SOCIAL_SERVICE_URL=http://localhost:4006
CHAT_SERVICE_URL=http://localhost:4007
NOTIFICATION_SERVICE_URL=http://localhost:4008
MEDIA_SERVICE_URL=http://localhost:4009
AI_SERVICE_URL=http://localhost:4010
PAYMENT_SERVICE_URL=http://localhost:4011
BUSINESS_SERVICE_URL=http://localhost:4012

# Service ports (override per app)
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
TRIP_SERVICE_PORT=4003
PLACE_SERVICE_PORT=4004
NAVIGATION_SERVICE_PORT=4005
SOCIAL_SERVICE_PORT=4006
CHAT_SERVICE_PORT=4007
NOTIFICATION_SERVICE_PORT=4008
MEDIA_SERVICE_PORT=4009
AI_SERVICE_PORT=4010
PAYMENT_SERVICE_PORT=4011
BUSINESS_SERVICE_PORT=4012

# MySQL — one DATABASE_URL per service (copy into each app's .env or use root .env)
DATABASE_URL_AUTH=mysql://traveler:traveler123@localhost:3306/traveler_auth
DATABASE_URL_USER=mysql://traveler:traveler123@localhost:3306/traveler_user
DATABASE_URL_TRIP=mysql://traveler:traveler123@localhost:3306/traveler_trip
DATABASE_URL_PLACE=mysql://traveler:traveler123@localhost:3306/traveler_place
DATABASE_URL_NAVIGATION=mysql://traveler:traveler123@localhost:3306/traveler_navigation
DATABASE_URL_SOCIAL=mysql://traveler:traveler123@localhost:3306/traveler_social
DATABASE_URL_CHAT=mysql://traveler:traveler123@localhost:3306/traveler_chat
DATABASE_URL_NOTIFICATION=mysql://traveler:traveler123@localhost:3306/traveler_notification
DATABASE_URL_MEDIA=mysql://traveler:traveler123@localhost:3306/traveler_media
DATABASE_URL_AI=mysql://traveler:traveler123@localhost:3306/traveler_ai
DATABASE_URL_PAYMENT=mysql://traveler:traveler123@localhost:3306/traveler_payment
DATABASE_URL_BUSINESS=mysql://traveler:traveler123@localhost:3306/traveler_business

# Per-service DATABASE_URL (set PORT + DATABASE_URL in each Nest app)
# auth-service:   PORT=4001 DATABASE_URL=${DATABASE_URL_AUTH}
# user-service:   PORT=4002 DATABASE_URL=${DATABASE_URL_USER}
# trip-service:   PORT=4003 DATABASE_URL=${DATABASE_URL_TRIP}
# place-service:  PORT=4004 DATABASE_URL=${DATABASE_URL_PLACE}
# navigation:     PORT=4005 DATABASE_URL=${DATABASE_URL_NAVIGATION}
# social-service: PORT=4006 DATABASE_URL=${DATABASE_URL_SOCIAL}
# chat-service:   PORT=4007 DATABASE_URL=${DATABASE_URL_CHAT}
# notification:   PORT=4008 DATABASE_URL=${DATABASE_URL_NOTIFICATION}
# media-service:  PORT=4009 DATABASE_URL=${DATABASE_URL_MEDIA}
# ai-service:     PORT=4010 DATABASE_URL=${DATABASE_URL_AI}
# payment:        PORT=4011 DATABASE_URL=${DATABASE_URL_PAYMENT}
# business:       PORT=4012 DATABASE_URL=${DATABASE_URL_BUSINESS}
