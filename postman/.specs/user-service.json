 "info": {
  "title": "user-service",
  "description": "Traveler Guide \u2014 user-service",
  "version": "1.0",
  "contact": {}
 },
 "tags": [],
 "servers": [],
 "components": {
  "securitySchemes": {
   "bearer": {
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "type": "http"
   }
  },
  "schemas": {
   "UpdateProfileDto": {
    "type": "object",
    "properties": {
     "displayName": {
      "type": "string",
      "example": "Huzaifa"
     },
     "bio": {
      "type": "string",
      "example": "Traveler and photographer based in Riyadh."
     },
     "location": {
      "type": "string",
      "example": "Riyadh, Saudi Arabia"
     },
     "website": {
      "type": "string",
      "example": "https://example.com"
     }
    }
   },
   "UpdatePhotoDto": {
    "type": "object",
    "properties": {
     "caption": {
      "type": "string",
      "example": "Sunset in AlUla"
     }
    }
   },
   "UpsertSocialLinkDto": {
    "type": "object",
    "properties": {
     "platform": {
      "type": "string",
      "enum": [
       "instagram",
       "twitter",
       "facebook",
       "linkedin",
       "youtube",
       "tiktok",
       "snapchat",
       "website"
      ],
      "example": "instagram"
     },
     "url": {
      "type": "string",
      "example": "https://instagram.com/username"
     }
    },
    "required": [
     "platform",
     "url"
    ]
   },
   "CreateRowDto": {
    "type": "object",
    "properties": {
     "data": {
      "type": "object",
      "description": "Column values for the new row."
     }
    },
    "required": [
     "data"
    ]
   },
   "UpdateRowDto": {
    "type": "object",
    "properties": {
     "where": {
      "type": "object",
      "description": "Primary-key values identifying the row."
     },
     "data": {
      "type": "object",
      "description": "Editable column values to write."
     }
    },
    "required": [
     "where",
     "data"
    ]
   },
   "DeleteRowDto": {
    "type": "object",
    "properties": {
     "where": {
      "type": "object",
      "description": "Primary-key values identifying the row."
     }
    },
    "required": [
     "where"
    ]
   }
  }
 }
