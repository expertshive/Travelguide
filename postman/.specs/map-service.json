  "/v1/map/geocode/search": {
   "get": {
    "operationId": "GeocodeController_search",
    "parameters": [
     {
      "name": "q",
      "required": true,
      "in": "query",
      "schema": {
       "example": "King Fahd Road",
       "type": "string"
