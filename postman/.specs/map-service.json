     },
     {
      "name": "latitude",
      "required": false,
      "in": "query",
      "description": "Bias results near this latitude",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "longitude",
      "required": false,
      "in": "query",
      "description": "Bias results near this longitude",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "limit",
      "required": false,
      "in": "query",
      "schema": {
       "default": 8,
       "type": "number"
      }
     }
    ],
    "responses": {
     "200": {
      "description": ""
     }
    },
    "security": [
     {
      "bearer": []
     }
    ],
    "summary": "Address autocomplete and place search",
    "tags": [
     "geocode"
    ]
   }
  },
