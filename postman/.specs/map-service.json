 "info": {
  "title": "map-service",
  "description": "Traveler Guide \u2014 maps, geocoding, and routing",
  "version": "1.0",
  "contact": {}
 },
 "tags": [],
 "servers": [],
 "components": {
  "securitySchemes": {
   "bearer": {
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "type": "http"
   }
  },
  "schemas": {
   "SavePlaceDto": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "enum": [
       "HOME",
       "WORK",
       "CUSTOM"
      ]
     },
     "name": {
      "type": "string"
     },
     "address": {
      "type": "string"
     },
     "latitude": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     }
    },
    "required": [
     "label",
     "name",
     "address",
     "latitude",
     "longitude"
    ]
   },
   "PointDto": {
    "type": "object",
    "properties": {
     "latitude": {
      "type": "number",
      "example": 24.7136
     },
     "longitude": {
      "type": "number",
      "example": 46.6753
     }
    },
    "required": [
     "latitude",
     "longitude"
    ]
   },
   "AvoidDto": {
    "type": "object",
    "properties": {
     "tolls": {
      "type": "boolean"
     },
     "highways": {
      "type": "boolean"
     },
     "unpaved": {
      "type": "boolean"
     },
     "ferries": {
      "type": "boolean"
     }
    }
   },
   "CalculateRouteDto": {
    "type": "object",
    "properties": {
     "origin": {
      "$ref": "#/components/schemas/PointDto"
     },
     "destination": {
      "$ref": "#/components/schemas/PointDto"
     },
     "waypoints": {
      "description": "Ordered intermediate stops",
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PointDto"
      }
     },
     "mode": {
      "type": "string",
      "enum": [
       "driving",
       "motorcycle",
       "walking",
       "cycling"
      ],
      "default": "driving"
     },
     "preference": {
      "type": "string",
      "enum": [
       "fastest",
       "shortest"
      ],
      "default": "fastest"
     },
     "avoid": {
      "$ref": "#/components/schemas/AvoidDto"
     },
     "alternatives": {
      "type": "boolean",
      "default": false
     },
     "language": {
      "type": "string",
      "default": "en"
     }
    },
    "required": [
     "origin",
     "destination"
    ]
   },
   "RerouteDto": {
    "type": "object",
    "properties": {
     "origin": {
      "$ref": "#/components/schemas/PointDto"
     },
     "destination": {
      "$ref": "#/components/schemas/PointDto"
     },
     "waypoints": {
      "description": "Ordered intermediate stops",
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PointDto"
      }
     },
     "mode": {
      "type": "string",
      "enum": [
       "driving",
       "motorcycle",
       "walking",
       "cycling"
      ],
      "default": "driving"
     },
     "preference": {
      "type": "string",
      "enum": [
       "fastest",
       "shortest"
      ],
      "default": "fastest"
     },
     "avoid": {
      "$ref": "#/components/schemas/AvoidDto"
     },
     "alternatives": {
      "type": "boolean",
      "default": false
     },
     "language": {
      "type": "string",
      "default": "en"
     },
     "currentPosition": {
      "description": "Where the traveller actually is",
      "allOf": [
       {
        "$ref": "#/components/schemas/PointDto"
       }
      ]
     }
    },
    "required": [
     "origin",
     "destination",
     "currentPosition"
    ]
   },
   "EstimateStopImpactDto": {
    "type": "object",
    "properties": {
     "origin": {
      "$ref": "#/components/schemas/PointDto"
     },
     "destination": {
      "$ref": "#/components/schemas/PointDto"
     },
     "waypoints": {
      "description": "Ordered intermediate stops",
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PointDto"
      }
     },
     "mode": {
      "type": "string",
      "enum": [
       "driving",
       "motorcycle",
       "walking",
       "cycling"
      ],
      "default": "driving"
     },
     "preference": {
      "type": "string",
      "enum": [
       "fastest",
       "shortest"
      ],
      "default": "fastest"
     },
     "avoid": {
      "$ref": "#/components/schemas/AvoidDto"
     },
     "alternatives": {
      "type": "boolean",
      "default": false
     },
     "language": {
      "type": "string",
      "default": "en"
     },
     "candidateStop": {
      "description": "Candidate stop to insert",
      "allOf": [
       {
        "$ref": "#/components/schemas/PointDto"
       }
      ]
     }
    },
    "required": [
     "origin",
     "destination",
     "candidateStop"
    ]
   },
   "CreateRowDto": {
    "type": "object",
    "properties": {
     "data": {
      "type": "object",
      "description": "Column values for the new row."
     }
    },
    "required": [
     "data"
    ]
   },
   "UpdateRowDto": {
    "type": "object",
    "properties": {
     "where": {
      "type": "object",
      "description": "Primary-key values identifying the row."
     },
     "data": {
      "type": "object",
      "description": "Editable column values to write."
     }
    },
    "required": [
     "where",
     "data"
    ]
   },
   "DeleteRowDto": {
    "type": "object",
    "properties": {
     "where": {
      "type": "object",
      "description": "Primary-key values identifying the row."
     }
    },
    "required": [
     "where"
    ]
   }
  }
 }
}